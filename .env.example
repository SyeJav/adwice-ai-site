# Copy this file to .env (or .env.production on the build host) and replace
# every example value. Do not commit the resulting file.

# Use one full URL per market. The matching token is sent as a Bearer token.
ADWICE_EUR_API_URL=https://eu-api.example.com/api/adbud/register
ADWICE_EUR_API_TOKEN=replace-with-eur-token
ADWICE_INR_API_URL=https://api.adwice.in
ADWICE_INR_API_TOKEN=2Ts4V9ZJiiZMmIC7y9a4UZO3v2EaoW
ADWICE_USD_API_URL=https://api.myadwice.com
ADWICE_USD_API_TOKEN=TamZUHYl4RwlTy8GF8i1tH6lMeUlrF

# Optional fallback when a market does not have its own URL/token above.
ADWICE_API_BASE_URL=https://api.example.com
ADWICE_API_TOKEN=replace-with-fallback-token
ADWICE_ACCOUNT_REQUEST_PATH=/api/adbud/register

# SMTP settings for agency-demo notifications.
ADWICE_SMTP_HOST=smtp.gmail.com
ADWICE_SMTP_PORT=587
ADWICE_SMTP_SECURE=false
ADWICE_SMTP_REQUIRE_TLS=true
ADWICE_SMTP_USERNAME=myadwice@gmail.com
ADWICE_SMTP_PASSWORD=kkku fsji tvrr tshn
ADWICE_SMTP_FROM_ADDRESS=myadwice@gmail.com
ADWICE_SMTP_FROM_NAME=AdWice
ADWICE_SMTP_RECIPIENT=care@example.com