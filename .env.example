# Copy this file to .env (or .env.production on the build host) and replace
# every example value. Do not commit the resulting file.

# Use one full URL per market. The matching token is sent as a Bearer token.
ADWICE_EUR_API_URL=https://api.euro.myadwice.com/api/adbud/register
ADWICE_EUR_API_TOKEN=replace-with-eur-token

ADWICE_INR_API_URL=https://api.adwice.in/api/adbud/register
ADWICE_INR_API_TOKEN=2Ts4V9ZJiiZMmIC7y9a4UZO3v2EaoW

ADWICE_USD_API_URL=https://api.myadwice.com/api/adbud/register
ADWICE_USD_API_TOKEN=TamZUHYl4RwlTy8GF8i1tH6lMeUlrF

# Optional fallback when a market does not have its own URL/token above.
ADWICE_API_BASE_URL=https://api.adbud.test/
ADWICE_API_TOKEN=4FSj5rgDjy1d6c2YPKdXGMMsZgJa6P
ADWICE_ACCOUNT_REQUEST_PATH=/api/adbud/register

# SMTP settings for agency-demo notifications.
ADWICE_SMTP_HOST=smtp.gmail.com
ADWICE_SMTP_PORT=587
ADWICE_SMTP_SECURE=false
ADWICE_SMTP_REQUIRE_TLS=true
ADWICE_SMTP_USERNAME=myadwice@gmail.com
ADWICE_SMTP_PASSWORD=kkku fsji tvrr tshn
ADWICE_SMTP_FROM_ADDRESS=myadwice@gmail.com
ADWICE_SMTP_FROM_NAME=AdWice
ADWICE_SMTP_RECIPIENT=care@example.com

# Website Analyzer uses a dedicated Redis database for background jobs,
# reports, caching, and anonymous rate limits.
REDIS_URL=redis://127.0.0.1:6379
WEBSITE_ANALYZER_ENABLED=true
WEBSITE_ANALYZER_VERSION=1.0
WEBSITE_ANALYZER_MAX_PAGES=5
WEBSITE_ANALYZER_CACHE_HOURS=24
WEBSITE_ANALYZER_RATE_LIMIT=3

# Optional providers. Performance and semantic findings are skipped when unset.
GOOGLE_PAGESPEED_API_KEY=
OPENAI_API_KEY=
WEBSITE_ANALYZER_AI_ENABLED=true
WEBSITE_ANALYZER_AI_MODEL=gpt-4o-mini

# Optional LeadProof overrides. The application defaults to the production
# tracker and public site key shown below. These values are browser-visible.
NEXT_PUBLIC_LEADPROOF_SCRIPT_URL=https://leads.myadwice.com/app/tracker.js
NEXT_PUBLIC_LEADPROOF_SITE_KEY=lp_site_9eb6bbc90d33ee8e232c3488d267d61e
